// Online C++ compiler to run C++ program online
#include <iostream>
#include <vector>
using namespace std;

void removedup(vector<int>& a){
    for(int i=0;i<a.size();i++){
        for(int j=i+1;j<a.size();j++){
            if(a[i]==a[j]){
                int key=j;
                for(int m=key;m<a.size()-1;m++){
                    a[m]=a[m+1];
                }
        
                j--;a.pop_back();
            }
        }
    }
}
    
  
    
int main() {
   vector<int> a={0,0,1,1,1,1,2,2,3,3,4};
   removedup(a);
   for(int i=0;i<a.size();i++){
       cout<<a[i]<<" ";
   }

    return 0;
}
